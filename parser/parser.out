Grammar

Rule 0     S' -> expression
Rule 1     expression -> expression AND expression
Rule 2     expression -> expression OR expression
Rule 3     expression -> NOT expression
Rule 4     expression -> term
Rule 5     expression -> LPAREN expression RPAREN
Rule 6     term -> LPAREN term RPAREN
Rule 7     term -> field EQUALS value
Rule 8     term -> field NOT_EQUALS value
Rule 9     term -> field EQUALS WILDCARD_WORD
Rule 10    term -> field NOT_EQUALS WILDCARD_WORD
Rule 11    term -> field GT comparable
Rule 12    term -> field LT comparable
Rule 13    term -> field GTE comparable
Rule 14    term -> field LTE comparable
Rule 15    term -> field
Rule 16    value -> WORD
Rule 17    field -> WORD
Rule 18    value -> comparable
Rule 19    comparable -> NUMBER
Rule 20    comparable -> DATE

