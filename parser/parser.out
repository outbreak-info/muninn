LT                   : 12
LTE                  : 14
NOT                  : 3
NOT_EQUALS           : 8 10
NUMBER               : 19
OR                   : 2
RPAREN               : 5 6
WILDCARD_WORD        : 9 10
WORD                 : 16 17
error                : 

